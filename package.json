{
  "name": "dokkaebi-midnight-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DOKKAEBI: The Midnight Game - Facebook Instant Game & Backend",
  "workspaces": [
    "shared",
    "game",
    "backend"
  ],
  "scripts": {
    "build:shared": "npm --workspace=@dokkaebi/shared run build",
    "build:game": "npm --workspace=@dokkaebi/game run build",
    "build": "npm run build:shared && npm run build:game",
    "dev:game": "npm --workspace=@dokkaebi/game run dev",
    "dev": "npm run dev:game",
    "test": "npm --workspace=@dokkaebi/shared test --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
